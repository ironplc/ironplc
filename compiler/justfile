set windows-shell := ["powershell.exe", "-c"]

# The executables every installer and package ships. This is the single Unix
# packaging list -- both `_package-macos` and `_package-linux` read it -- and the
# `shipped_binaries_guard` test asserts it matches the workspace's `[[bin]]`
# targets, `setup.nsi`, and the Homebrew formula. A binary that is built but not
# listed here fails that guard rather than silently missing from the release.
binaries := "ironplcc ironplcvm ironplcmcp ironplcdap"

alias ci := default
# Coverage runs all tests with instrumentation, so separate test step is redundant
default: compile coverage lint dupes

setup:
  cargo install cargo-release
  cargo install cargo-llvm-cov
  cargo install cargo-dupes

compile:
  cargo build

# Run the test suite. Excludes benchmarks (which `--all-targets` would run as
# tests, since st_benchmark uses `harness = false`); benches are compile-checked
# by `just lint` and run via `just bench`. Mirrors the targets `just coverage`
# exercises.
test:
  cargo test --quiet --workspace

# Run tests and produce coverage report
coverage:
  cargo llvm-cov --quiet --ignore-filename-regex "cargo|dsl_macro_derive|container_derive|rustup" --workspace --fail-under-lines 85 --show-missing-lines --lcov --output-path lcov.info

# Fix linting errors.
format:
  cargo clippy --all-targets --fix
  cargo fmt --all

# Check for linting errors.
lint:
  cargo clippy --all-targets
  cargo fmt --all -- --check

# Check for duplicate code (AST-based).
dupes:
  cargo dupes check --max-exact-percent 10 --max-near-percent 5 --exclude-tests --min-lines 10

# Report duplication including test code (informational only; does not gate CI).
# The blocking `dupes` recipe above uses `--exclude-tests`, so test duplication is
# otherwise unmeasured. Use this to track redundancy-reduction progress in tests.
dupes-tests:
  cargo dupes check --max-exact-percent 100 --max-near-percent 100 --min-lines 10

# Set the version number for this component.
version version:
  cargo release version {{version}} --execute --no-confirm

# Creates the installer or package (as appropriate for platform)
package version filename target:
  just _package-{{os()}} {{version}} {{filename}} {{target}}

# Creates a "Windows installer" running from Linux. Only useful to testing.
package-windows-on-linux version filename:
  cargo build --release --target x86_64-pc-windows-gnu

  # When building on Linux, we expect an empty extension
  makensis -DARTIFACTSDIR=".\target\x86_64-pc-windows-gnu\release" -DOUTFILE="{{filename}}" -DVERSION="{{version}}" -DEXTENSION="" "setup.nsi"

_package-windows version filename target:
  cargo build --release --target {{target}}

  # makensis will write to the directory with the NSI file or the absolute path
  # provided. It is pretty difficult to do this with justfile.
  & "C:\\Program Files (x86)\\NSIS\\Bin\\makensis" /DARTIFACTSDIR=".\target\{{target}}\release" /DOUTFILE="{{filename}}" /DVERSION="{{version}}" "setup.nsi"
  # Some versions of Windows do something funky with the path so that
  # Get-FileHash is not available. The prefix makes sure we run with a
  # compatible PowerShell instance.
  pwsh -noprofile -command '$env:PSModulePath = \"$PSHOME/Modules\"; Get-FileHash -Path "{{filename}}" -Algorithm SHA512 | Select-Object -ExpandProperty Hash | Out-File {{filename}}.sha256'

_package-macos version filename target:
  cargo build --release --target {{target}}
  cp bom.cdx.json target/{{target}}/release/bom.cdx.json
  # Stage the compatibility libraries so they ship beside the binaries; the
  # loader reads them from `<bindir>/resources/libs` at runtime.
  rm -rf target/{{target}}/release/resources/libs
  mkdir -p target/{{target}}/release/resources
  cp -R sources/resources/libs target/{{target}}/release/resources/libs
  tar -czvf {{filename}} --directory=target/{{target}}/release {{binaries}} bom.cdx.json resources
  shasum -a 256 {{filename}} > {{filename}}.sha256

_package-linux version filename target:
  cargo build --release --target {{target}}
  cp bom.cdx.json target/{{target}}/release/bom.cdx.json
  # Stage the compatibility libraries so they ship beside the binaries; the
  # loader reads them from `<bindir>/resources/libs` at runtime.
  rm -rf target/{{target}}/release/resources/libs
  mkdir -p target/{{target}}/release/resources
  cp -R sources/resources/libs target/{{target}}/release/resources/libs
  tar -czvf {{filename}} --directory=target/{{target}}/release {{binaries}} bom.cdx.json resources
  sha256sum {{filename}} > {{filename}}.sha256

# Smoke-test the release binaries that were just packaged: run the exact bytes
# that went into the installer/tarball (target/<target>/release), not a test
# build. `cargo test` is a debug-profile build for the *host*, so nothing in
# `just test` ever executed the release artifacts we ship.
#
# The assertions live in tests/e2e/library/verify.sh -- the same script the
# post-release library end-to-end test runs against an installed compiler -- so
# the packaged bytes and the installed bytes are checked identically, and a new
# assertion lands in both places at once. Paths handed to the script are
# repository-root relative because the script cd's to the repository root.
#
# Run after `just package`; only meaningful when the runner can execute <target>.
verify-package target:
  just _verify-package-{{os()}} {{target}}

_verify-package-linux target:
  sh ../tests/e2e/library/verify.sh compiler/target/{{target}}/release/ironplcc compiler/target/{{target}}/release/ironplcvm

_verify-package-macos target:
  #!/usr/bin/env sh
  set -eu
  # Running the x86_64 build on the arm64 runner needs Rosetta 2. The install
  # is a no-op when already present; failure falls through to the real check,
  # which then fails loudly if the binary truly cannot execute.
  if [ "$(uname -m)" = "arm64" ]; then
    sudo softwareupdate --install-rosetta --agree-to-license >/dev/null 2>&1 || true
  fi
  sh ../tests/e2e/library/verify.sh compiler/target/{{target}}/release/ironplcc compiler/target/{{target}}/release/ironplcvm

# The unix package recipes stage resources/libs beside the binaries before
# tarring, so the release directory already has the installed layout. On Windows
# the NSIS installer does that copy at install time (setup.nsi), so stage the
# same layout here before running the check.
#
# Each line is a separate PowerShell process (set windows-shell), so the script
# runs through Git for Windows' bash and only the $LASTEXITCODE propagation stays
# in PowerShell -- without it a failing script would be reported as a pass.
_verify-package-windows target:
  if (Test-Path "target\{{target}}\release\resources\libs") { Remove-Item -Recurse -Force "target\{{target}}\release\resources\libs" }
  New-Item -ItemType Directory -Force "target\{{target}}\release\resources" | Out-Null
  Copy-Item -Recurse "sources\resources\libs" "target\{{target}}\release\resources\libs"
  bash ../tests/e2e/library/verify.sh compiler/target/{{target}}/release/ironplcc.exe compiler/target/{{target}}/release/ironplcvm.exe; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# Builds the Homebrew repository to release for Mac and Linux
publish $VERSION $MACFILENAME $LINUXFILENAME:
  # Use actual releases in order to build the Homebrew tap.
  # The advantage of using a real release is that we are guaranteed that the
  # files are accessible and do not publish a new release if the release failed.
  curl -LO --fail https://github.com/ironplc/ironplc/releases/download/v{{VERSION}}/{{MACFILENAME}}.sha256 --output {{MACFILENAME}}.sha256
  curl -LO --fail https://github.com/ironplc/ironplc/releases/download/v{{VERSION}}/{{LINUXFILENAME}}.sha256 --output {{LINUXFILENAME}}.sha256
  rm -rf target/homebrew
  mkdir -p target
  cp -r homebrew target
  export MACSHA256=`cat {{MACFILENAME}}.sha256 | cut -f 1 -d " "` && export LINUXSHA256=`cat {{LINUXFILENAME}}.sha256 | cut -f 1 -d " "` && envsubst < homebrew/Formula/ironplc.rb > target/homebrew/Formula/ironplc.rb

# Generate a CycloneDX JSON SBOM (bom.cdx.json) for the workspace. Requires cargo-cyclonedx and cyclonedx CLI on PATH.
sbom version:
  just _sbom-{{os()}} {{version}}

# Install SBOM generation tools (cargo-cyclonedx and cyclonedx-cli) so `just sbom` runs locally.
setup-sbom:
  cargo install --locked cargo-cyclonedx
  just _install-cyclonedx-cli-{{os()}}

_install-cyclonedx-cli-linux:
  curl -L --fail -o /tmp/cyclonedx https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.27.2/cyclonedx-linux-x64
  chmod +x /tmp/cyclonedx
  sudo mv /tmp/cyclonedx /usr/local/bin/cyclonedx

_install-cyclonedx-cli-macos:
  #!/usr/bin/env bash
  set -euo pipefail
  case "$(uname -m)" in
    arm64|aarch64) suffix=osx-arm64 ;;
    *)             suffix=osx-x64   ;;
  esac
  curl -L --fail -o /tmp/cyclonedx "https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.27.2/cyclonedx-${suffix}"
  chmod +x /tmp/cyclonedx
  sudo mv /tmp/cyclonedx /usr/local/bin/cyclonedx

_install-cyclonedx-cli-windows:
  Invoke-WebRequest -Uri "https://github.com/CycloneDX/cyclonedx-cli/releases/download/v0.27.2/cyclonedx-win-x64.exe" -OutFile "$env:USERPROFILE\.cargo\bin\cyclonedx.exe"

_sbom-linux version:
  cargo cyclonedx --format json --spec-version 1.5 --all --override-filename _ironplc_bom
  cyclonedx merge --hierarchical --name ironplc-compiler --version {{version}} \
    --input-files $(find . -name "_ironplc_bom.json" -not -path "./target/*" | sort) \
    --output-file bom.cdx.json --output-format json
  find . -name "_ironplc_bom.json" -not -path "./target/*" -delete
  sha256sum bom.cdx.json > bom.cdx.json.sha256

_sbom-macos version:
  cargo cyclonedx --format json --spec-version 1.5 --all --override-filename _ironplc_bom
  cyclonedx merge --hierarchical --name ironplc-compiler --version {{version}} \
    --input-files $(find . -name "_ironplc_bom.json" -not -path "./target/*" | sort) \
    --output-file bom.cdx.json --output-format json
  find . -name "_ironplc_bom.json" -not -path "./target/*" -delete
  shasum -a 256 bom.cdx.json > bom.cdx.json.sha256

_sbom-windows version:
  cargo cyclonedx --format json --spec-version 1.5 --all --override-filename _ironplc_bom
  $files = Get-ChildItem -Recurse -Filter "_ironplc_bom.json" | Where-Object { $_.FullName -notlike "*\target\*" } | ForEach-Object { $_.FullName }; cyclonedx merge --hierarchical --name ironplc-compiler --version {{version}} --input-files $files --output-file bom.cdx.json --output-format json
  Get-ChildItem -Recurse -Filter "_ironplc_bom.json" | Where-Object { $_.FullName -notlike "*\target\*" } | Remove-Item
  pwsh -noprofile -command 'Get-FileHash -Path "bom.cdx.json" -Algorithm SHA256 | Select-Object -ExpandProperty Hash | Out-File bom.cdx.json.sha256'

# Run performance benchmarks
bench:
  cargo bench --package ironplc-vm --features ironplc-vm/test-support

# Run benchmarks and save baseline for comparison
bench-baseline name="main":
  cargo bench --package ironplc-vm --features ironplc-vm/test-support -- --save-baseline {{name}}

# Updates dependencies to latest version (or at least tries)
update:
  cargo update

expand:
  cd dsl_macro_derive && cargo rustc --profile=check -- -Zunpretty=expanded

# Remove build artifacts
clean:
  cargo clean
  rm -f lcov.info
