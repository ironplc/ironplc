{
  "name": "ironplc",
  "displayName": "IronPLC",
  "publisher": "ironplc",
  "description": "IEC 61131-3 Structured Text language support with real-time error checking, syntax highlighting, and build tools for PLC programs.",
  "version": "0.238.0",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Garret Fick"
  },
  "categories": [
    "Programming Languages"
  ],
  "homepage": "https://www.ironplc.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ironplc/ironplc.git",
    "directory": "integrations/vscode"
  },
  "bugs": {
    "url": "https://github.com/ironplc/ironplc/issues"
  },
  "qna": "https://github.com/ironplc/ironplc/issues",
  "activationEvents": [
    "onCustomEditor:ironplc.iplcViewer",
    "onLanguage:61131-3-st",
    "onLanguage:twincat-pou",
    "onLanguage:twincat-gvl",
    "onLanguage:twincat-dut",
    "onLanguage:plcopen-xml",
    "onDebugResolve:ironplc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ironplc.createNewStructuredTextFile",
        "title": "New Structured Text File",
        "shortTitle": "Structured Text File",
        "category": "IronPLC"
      },
      {
        "command": "ironplc.runProgram",
        "title": "Run Program",
        "category": "IronPLC",
        "icon": "$(play)"
      },
      {
        "command": "ironplc.stopProgram",
        "title": "Stop Program",
        "category": "IronPLC",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ironplc.pauseProgram",
        "title": "Pause/Resume Program",
        "category": "IronPLC",
        "icon": "$(debug-pause)"
      },
      {
        "command": "ironplc.stepScan",
        "title": "Step Scan Cycle",
        "category": "IronPLC",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "ironplc.scanCount",
        "title": "Show Scan Count",
        "category": "IronPLC",
        "icon": "$(symbol-numeric)"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "ironplc.createNewStructuredTextFile",
          "group": "file",
          "when": "!virtualWorkspace"
        }
      ],
      "debug/toolBar": [
        {
          "command": "ironplc.stepScan",
          "group": "navigation@1",
          "when": "debugType == 'ironplc'"
        },
        {
          "command": "ironplc.scanCount",
          "group": "navigation@2",
          "when": "debugType == 'ironplc'"
        }
      ],
      "commandPalette": [
        {
          "command": "ironplc.stepScan",
          "when": "debugType == 'ironplc'"
        },
        {
          "command": "ironplc.scanCount",
          "when": "debugType == 'ironplc'"
        }
      ]
    },
    "configuration": {
      "title": "IronPLC",
      "properties": {
        "ironplc.path": {
          "markdownDescription": "Overrides the discovery of ironplcc application (ironplcc.exe on Windows). If empty, then discovers IronPLC based on the path variable.",
          "type": "string",
          "default": "",
          "editPresentation": "singlelineText"
        },
        "ironplc.dapServerPath": {
          "markdownDescription": "Overrides the path to the IronPLC debug server (ironplcdap, ironplcdap.exe on Windows). If empty, then discovers the server next to the ironplcc compiler.",
          "type": "string",
          "default": "",
          "editPresentation": "singlelineText"
        },
        "ironplc.logLevel": {
          "markdownDescription": "Log level for the IronPLC compiler.",
          "type": "string",
          "default": "ERROR",
          "enum": [
            "ERROR",
            "WARN",
            "INFO",
            "DEBUG",
            "TRACE"
          ]
        },
        "ironplc.logFile": {
          "markdownDescription": "Log file for the IronPLC compiler.",
          "type": "string",
          "default": "",
          "editPresentation": "singlelineText"
        },
        "ironplc.dialect": {
          "markdownDescription": "Language dialect preset. Controls IEC edition and extensions.\n\n- `iec61131-3-ed2`: Strict IEC 61131-3:2003 (Edition 2)\n- `iec61131-3-ed3`: IEC 61131-3:2013 (Edition 3) with `LTIME`, `REF_TO`, etc.\n- `rusty`: RuSTy-compatible — Edition 2 base with `REF_TO` and the extensions RuSTy accepts\n- `codesys`: CODESYS-compatible — Edition 2 base with `REF_TO` and the CODESYS extensions\n- `twincat`: TwinCAT-compatible — Edition 2 base with the extensions TwinCAT shares with CODESYS (no `REF_TO`; TwinCAT uses `REFERENCE TO`/`POINTER TO`)",
          "type": "string",
          "default": "iec61131-3-ed2",
          "enum": [
            "iec61131-3-ed2",
            "iec61131-3-ed3",
            "rusty",
            "codesys",
            "twincat"
          ],
          "enumItemLabels": [
            "IEC 61131-3:2003 (Edition 2)",
            "IEC 61131-3:2013 (Edition 3)",
            "RuSTy-compatible",
            "CODESYS-compatible",
            "TwinCAT-compatible"
          ],
          "enumDescriptions": [
            "IEC 61131-3:2003 (Edition 2)",
            "IEC 61131-3:2013 (Edition 3)",
            "RuSTy-compatible",
            "CODESYS-compatible",
            "TwinCAT-compatible"
          ]
        }
      }
    },
    "languages": [
      {
        "id": "61131-3-st",
        "aliases": [
          "IEC 61131-3",
          "Structured Text"
        ],
        "extensions": [
          ".st",
          ".iec"
        ],
        "configuration": "./decl/61131-3-st-language-configuration.json"
      },
      {
        "id": "twincat-pou",
        "aliases": [
          "PLCopen POU (.TcPOU)",
          "TwinCAT POU"
        ],
        "extensions": [
          ".TcPOU"
        ],
        "configuration": "./decl/61131-3-st-language-configuration.json"
      },
      {
        "id": "twincat-gvl",
        "aliases": [
          "PLCopen GVL (.TcGVL)",
          "TwinCAT GVL"
        ],
        "extensions": [
          ".TcGVL"
        ],
        "configuration": "./decl/61131-3-st-language-configuration.json"
      },
      {
        "id": "twincat-dut",
        "aliases": [
          "PLCopen DUT (.TcDUT)",
          "TwinCAT DUT"
        ],
        "extensions": [
          ".TcDUT"
        ],
        "configuration": "./decl/61131-3-st-language-configuration.json"
      },
      {
        "id": "plcopen-xml",
        "aliases": [
          "PLCopen XML",
          "IEC 61131-3 XML",
          "TC6 XML"
        ],
        "extensions": [],
        "firstLine": "^<\\?xml[^>]*\\?>\\s*(<project\\s+xmlns\\s*=\\s*[\"']http://www\\.plcopen\\.org/xml/tc6|<project\\s[^>]*xmlns\\s*=\\s*[\"']http://www\\.plcopen\\.org/xml/tc6)",
        "configuration": "./decl/plcopen-xml-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "61131-3-st",
        "scopeName": "source.61131-3-st",
        "path": "./syntaxes/61131-3-st.tmLanguage.json"
      },
      {
        "language": "plcopen-xml",
        "scopeName": "source.plcopen-xml",
        "path": "./syntaxes/plcopen-xml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.st": "61131-3-st"
        }
      },
      {
        "language": "twincat-pou",
        "scopeName": "source.plcopen-xml",
        "path": "./syntaxes/plcopen-xml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.st": "61131-3-st"
        }
      },
      {
        "language": "twincat-gvl",
        "scopeName": "source.plcopen-xml",
        "path": "./syntaxes/plcopen-xml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.st": "61131-3-st"
        }
      },
      {
        "language": "twincat-dut",
        "scopeName": "source.plcopen-xml",
        "path": "./syntaxes/plcopen-xml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.st": "61131-3-st"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "ironplc.iplcViewer",
        "displayName": "IPLC Bytecode Viewer",
        "selector": [
          {
            "filenamePattern": "*.iplc"
          }
        ],
        "priority": "default"
      }
    ],
    "taskDefinitions": [
      {
        "type": "ironplc",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The IronPLC task to perform.",
            "enum": [
              "compile"
            ]
          }
        }
      }
    ],
    "breakpoints": [
      {
        "language": "61131-3-st"
      },
      {
        "language": "twincat-pou"
      }
    ],
    "debuggers": [
      {
        "type": "ironplc",
        "label": "IronPLC",
        "languages": [
          "61131-3-st",
          "twincat-pou"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to a Structured Text source file or a compiled .iplc container to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause before the first scan cycle begins.",
                "default": false
              },
              "scanLimit": {
                "type": "number",
                "description": "Maximum number of scan cycles to run before disconnecting (runaway prevention). 0 means unlimited."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ironplc",
            "request": "launch",
            "name": "IronPLC: Debug Active File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "IronPLC: Launch",
            "description": "Debug the active Structured Text file with IronPLC.",
            "body": {
              "type": "ironplc",
              "request": "launch",
              "name": "IronPLC: Debug Active File",
              "program": "${file}",
              "stopOnEntry": false
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "generate-problems": "node scripts/generate-problems.js",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "npm run generate-problems && esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -p ./",
    "precompile": "npm run generate-problems",
    "compile": "tsc -p ./",
    "postcompile": "cp src/screenshots/settings.json out/screenshots/settings.json && cp -r src/screenshots/fixtures out/screenshots/fixtures",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "validate-grammars": "node scripts/validate-grammars.js",
    "lint": "eslint src/**/*.ts && npm run validate-grammars",
    "test:unit": "c8 --check-coverage --lines 80 --include 'out/*.js' mocha --ui tdd 'out/test/unit/**/*.test.js'",
    "test:functional": "node ./out/test/functional/runTest.js",
    "test:grammar": "vscode-tmgrammar-snap -s source.plcopen-xml \"tests/grammar/snap/**/*.xml\" && vscode-tmgrammar-snap \"tests/grammar/snap/**/*.st\" && vscode-tmgrammar-snap \"tests/grammar/snap/**/*.TcPOU\" && vscode-tmgrammar-snap \"tests/grammar/snap/**/*.TcGVL\" && vscode-tmgrammar-snap \"tests/grammar/snap/**/*.TcDUT\"",
    "test:grammar:update": "vscode-tmgrammar-snap -u -s source.plcopen-xml \"tests/grammar/snap/**/*.xml\" && vscode-tmgrammar-snap -u \"tests/grammar/snap/**/*.st\" && vscode-tmgrammar-snap -u \"tests/grammar/snap/**/*.TcPOU\" && vscode-tmgrammar-snap -u \"tests/grammar/snap/**/*.TcGVL\" && vscode-tmgrammar-snap -u \"tests/grammar/snap/**/*.TcDUT\"",
    "check-invariants": "node out/test/checkInvariants.js"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5",
    "@stylistic/eslint-plugin-ts": "^4",
    "@types/mocha": "^10.0.0",
    "@types/node": "26.x",
    "@types/upng-js": "^2.1.5",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.63.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.0.0",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "glob": "^13.0.6",
    "mocha": "^11.0.0",
    "ovsx": "^1.0.2",
    "playwright": "^1.52.0",
    "typescript": "^5.1.6",
    "upng-js": "^2.1.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^10"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid": "^14.0.0"
  }
}
