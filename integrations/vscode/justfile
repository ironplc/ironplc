set windows-shell := ["powershell.exe", "-c"]

default: compile lint

# The primary set of tasks for continuous integration validation.
ci:
  just compile
  just check-invariants
  just lint
  just test-grammar
  just test-unit
  just test

# Setup required dependencies. Use this to bootstrap a new host.
setup:
  npm ci

# Compile the application code. Because this is type script, this effectively validates the code.
compile:
  npm run compile

# Run integration tests.
test:
  just _test-{{os()}}

_test-windows:
  npm run test:functional

_test-macos:
  npm run test:functional

# Integration tests require Xvfb enabled environment for Linux, so use that to
# run tests.
_test-linux:
  xvfb-run -a npm run test:functional

# Check the code for compliance with style (lint) rules.
lint:
  npm run lint

# Verify that all declared capabilities have test coverage.
check-invariants:
  npm run check-invariants

# Run unit tests with coverage enforcement.
test-unit:
  npm run test:unit

# Run grammar snapshot tests to verify syntax highlighting.
test-grammar:
  npm run test:grammar

# Update grammar snapshot files (run after intentional grammar changes).
update-grammar-snapshots:
  npm run test:grammar:update

# Build the VSIX package for this component.
package filename:
  npx vsce package --out {{filename}}

# Build the Marketplace VSIX package. The Visual Studio Marketplace uses the
# extension ID ironplc.ironplc-vscode because the original ironplc.ironplc ID
# cannot be reused; Open VSX keeps ironplc.ironplc. The `displayName` is also
# overridden to "IronPLC IDE" because the Marketplace still reserves the bare
# "IronPLC" display name from the removed listing and rejects it as in use; the
# publisher (ironplc) is unchanged. Open VSX keeps `name: ironplc` and
# `displayName: IronPLC`. Both overrides mutate package.json in the (ephemeral)
# build tree only.
#
# "IDE" is deliberately neutral -- not "Structured Text" or "IEC 61131-3" --
# so the name still fits if other languages or standards are added later. A
# Marketplace display name cannot be changed once published.
#
# The two-VSIX scheme is safe because only `name` and `displayName` differ.
# Command IDs, language IDs and activation events are literal strings that do
# not derive from `name`, so nothing else diverges between the builds.
package-marketplace filename:
  npm pkg set name=ironplc-vscode
  npm pkg set 'displayName=IronPLC IDE'
  npx vsce package --out {{filename}}

# Generate a CycloneDX JSON SBOM (bom.cdx.json) for the VS Code extension.
sbom version:
  just _sbom-{{os()}} {{version}}

_sbom-linux version:
  npx --yes @cyclonedx/cyclonedx-npm@^4.0.0 --output-format JSON --output-file bom.cdx.json --spec-version 1.5 --package-lock-only
  sha256sum bom.cdx.json > bom.cdx.json.sha256

_sbom-macos version:
  npx --yes @cyclonedx/cyclonedx-npm@^4.0.0 --output-format JSON --output-file bom.cdx.json --spec-version 1.5 --package-lock-only
  shasum -a 256 bom.cdx.json > bom.cdx.json.sha256

_sbom-windows version:
  npx --yes @cyclonedx/cyclonedx-npm@^4.0.0 --output-format JSON --output-file bom.cdx.json --spec-version 1.5 --package-lock-only
  pwsh -noprofile -command 'Get-FileHash -Path "bom.cdx.json" -Algorithm SHA256 | Select-Object -ExpandProperty Hash | Out-File bom.cdx.json.sha256'

# Sets the version number for this component.
version version:
  npm version {{version}}

# Updates dependencies to latest version (or at least tries to)
update:
  npm update

# Publishes a VSIX archive to the Visual Studio Marketplace
publish vsixfilename:
  # vsixfilename: The name of the VSIX archive to publish.
  #
  # VSCE_PAT: The personal access token for publishing (read from environment)
  ls
  npx vsce publish -p $VSCE_PAT --packagePath {{vsixfilename}}

# Publishes a VSIX archive to the Open VSX Registry (for Cursor, Windsurf, etc.)
publish-openvsx vsixfilename:
  # vsixfilename: The name of the VSIX archive to publish.
  #
  # OVSX_PAT: The personal access token for Open VSX publishing (read from environment)
  npx ovsx publish {{vsixfilename}} -p $OVSX_PAT

# Capture VS Code extension screenshots for documentation.
# Requires `just compile` first. macOS runs natively; Linux uses Xvfb.
# Screenshots are written to out/screenshots/output/.
# Run `just screenshots` from the repository root to also copy them into docs.
screenshots:
  just _screenshots-{{os()}}

_screenshots-macos:
  node ./out/screenshots/run.js

_screenshots-linux:
  xvfb-run -a --server-args="-screen 0 1920x1080x24" node ./out/screenshots/run.js

_screenshots-windows:
  node ./out/screenshots/run.js

# Remove build artifacts
clean:
  rm -rf out
  rm -f *.vsix
