set windows-shell := ["powershell.exe", "-c"]

# Checks over the specs themselves. These recipes run from the repository root
# rather than from specs/: what they police -- an ADR number cited as a bare
# "ADR-NNNN", a link to a plan that never reaches main -- is written in code
# comments, workflows and documentation all over the repository, not only here.

alias ci := default
default: adr-numbers adr-front-matter design-front-matter plan-citations

# Fail if one ADR number names more than one decision. The four-digit prefix of
# a file in specs/adrs/ is that decision's identity: prose and code comments cite
# decisions as a bare "ADR-NNNN", a form that cannot resolve when the number is
# ambiguous. A new ADR takes the next unused number.
adr-numbers:
  #!/usr/bin/env bash
  set -euo pipefail
  cd {{justfile_directory()}}/..
  numbers=$(git ls-files 'specs/adrs/*.md' | sed -n 's#^specs/adrs/\([0-9][0-9][0-9][0-9]\)-.*#\1#p')
  dupes=$(printf '%s\n' "$numbers" | sort | uniq -d)
  if [ -n "$dupes" ]; then
    echo "error: an ADR number names more than one decision." >&2
    echo "A bare \"ADR-NNNN\" citation cannot resolve to a duplicated number." >&2
    echo "Give the later ADR the next unused number and update the citations" >&2
    echo "that meant it." >&2
    echo >&2
    for number in $dupes; do
      git ls-files "specs/adrs/$number-*.md" >&2
    done
    exit 1
  fi
  echo "ADR numbers: all unique. Check passed."

# Fail if an ADR's front matter is missing or malformed. The status convention
# in specs/steering/development-standards.md is written in that front matter:
# `status:` and `date:` directly under the H1, and a status drawn from the four
# documented values. An ADR that predates the convention (or drifts out of it)
# is invisible to a status audit -- it reads as neither proposed nor accepted,
# and a census that greps for `status:` silently skips it.
adr-front-matter:
  #!/usr/bin/env bash
  set -euo pipefail
  cd {{justfile_directory()}}/..
  failed=0
  while read -r adr; do
    # Line 1 is the H1, line 2 blank, then status: and date:. Read the first
    # four lines rather than grepping the whole file so that a `status:` string
    # quoted deeper in the prose cannot stand in for real front matter.
    front=$(head -4 "$adr")
    status=$(printf '%s\n' "$front" | sed -n 's/^status: //p')
    date=$(printf '%s\n' "$front" | sed -n 's/^date: //p')
    if [ -z "$status" ]; then
      echo "error: $adr has no 'status:' in its front matter." >&2
      failed=1
      continue
    fi
    if [ -z "$date" ]; then
      echo "error: $adr has no 'date:' in its front matter." >&2
      failed=1
    fi
    case "$status" in
      proposed|accepted|rejected) ;;
      "superseded by ADR-"[0-9][0-9][0-9][0-9]*) ;;
      *)
        echo "error: $adr has status \"$status\", which is not one of" >&2
        echo "proposed, accepted, rejected, or \"superseded by ADR-NNNN\"." >&2
        failed=1
        ;;
    esac
  done < <(git ls-files 'specs/adrs/*.md')
  if [ "$failed" != "0" ]; then
    echo >&2
    echo "See specs/steering/development-standards.md for the status table." >&2
    exit 1
  fi
  echo "ADR front matter: all well-formed. Check passed."

# Fail if a design document's `status:` line holds a value the status table in
# specs/steering/development-standards.md does not define. The field separates a
# specification of intent from a specification of fact -- `approved` says the code
# does not implement this yet, `implemented` says it does -- so a misspelled or
# invented value is worse than no value: it reads as settled without saying which
# kind of settled, and the reader who finds a divergence cannot tell whether to
# fix the code or the document.
#
# Unlike the ADR check, presence is NOT required. The field arrived after most of
# specs/design/ was written, and a status inferred from a distance by whoever was
# migrating files is exactly the misinformation it exists to prevent. Documents
# gain it as someone who knows touches them.
design-front-matter:
  #!/usr/bin/env bash
  set -euo pipefail
  cd {{justfile_directory()}}/..
  failed=0
  while read -r doc; do
    # Line 1 is the H1, line 2 blank, then the optional status: and date:. Read
    # only the first four lines so that a `status:` string quoted deeper in the
    # prose -- these documents discuss ADR status constantly -- cannot be
    # mistaken for front matter.
    front=$(head -4 "$doc")
    status=$(printf '%s\n' "$front" | sed -n 's/^status: //p')
    if [ -z "$status" ]; then
      continue
    fi
    case "$status" in
      proposed|approved|"partially implemented"|implemented) ;;
      *)
        echo "error: $doc has status \"$status\", which is not one of" >&2
        echo "proposed, approved, partially implemented, or implemented." >&2
        failed=1
        continue
        ;;
    esac
    date=$(printf '%s\n' "$front" | sed -n 's/^date: //p')
    if [ -z "$date" ]; then
      echo "error: $doc has a 'status:' but no 'date:' in its front matter." >&2
      failed=1
    fi
  done < <(git ls-files 'specs/design/**.md' 'specs/design/*.md' | sort -u)
  if [ "$failed" != "0" ]; then
    echo >&2
    echo "See specs/steering/development-standards.md for the status table." >&2
    exit 1
  fi
  echo "Design document front matter: all well-formed. Check passed."

# Fail if anything cites specs/plans/. A plan lives in a PR that is never
# merged, so a reference to one dangles. Rationale
# that something needs to point at belongs in specs/adrs/ or specs/design/.
#
# The process documents below describe the rule, so they are allowed to name the
# directory. Everything else -- code, tests, workflows, this justfile, design
# documents, ADRs -- is not.
plan-citations:
  #!/usr/bin/env bash
  set -euo pipefail
  cd {{justfile_directory()}}/..
  # Matches both the repo-relative form (specs/plans/...) and relative links
  # such as ../plans/foo.md or ../../plans/foo.md, which markdown cross-links
  # inside specs/ use and which a literal "specs/plans" search misses entirely.
  common_excludes=(':!specs/plans'
    ':!CLAUDE.md' ':!CURSOR.md' ':!CONTRIBUTING.md'
    ':!.cursor' ':!specs/steering'
    ':!specs/justfile')
  hits=$(git grep -nE "specs/plans|\.\./plans/|\.\./\.\./plans/" -- . \
    "${common_excludes[@]}" || true)
  # A citation need not carry a path: "see the plan's X section" dangles just
  # as badly once the plan is gone, and the reader cannot even tell which file
  # was meant. Prose form is checked outside markdown only -- a design document
  # saying "the plan" is referring to itself.
  prose=$(git grep -nE "[Tt]he plan'?s?\b" -- . \
    "${common_excludes[@]}" ':!*.md' || true)
  # A plan can also be cited by bare filename, with no directory at all
  # ("see foo-plan.md"). That dangles on deletion like any other form and is
  # invisible to both patterns above, so check each plan's own basename.
  # Skip any basename that also names a real file elsewhere (several plans
  # share a name with the design document they implement), and require the
  # match to start at a filename boundary so a plan name that is a suffix of
  # an ADR filename does not trip it.
  bare=""
  for plan in specs/plans/*.md; do
    [ -e "$plan" ] || continue
    base=$(basename "$plan")
    if [ "$(git ls-files "*/$base" "$base" | grep -vc '^specs/plans/')" != "0" ]; then
      continue
    fi
    found=$(git grep -nE "(^|[^A-Za-z0-9._/-])$base" -- . "${common_excludes[@]}" || true)
    [ -n "$found" ] && bare=$(printf '%s\n%s' "$bare" "$found")
  done
  hits=$(printf '%s\n%s\n%s' "$hits" "$prose" "$bare" | grep -v '^$' || true)
  if [ -n "$hits" ]; then
    echo "error: specs/plans/ is cited outside specs/plans/ itself." >&2
    echo "A plan never reaches main and is not a stable reference" >&2
    echo "target. Cite an ADR or a design document instead." >&2
    echo >&2
    echo "$hits" >&2
    exit 1
  fi
  echo "Plan citations: none. Check passed."
